{
  "mcpServers": {
    "blender": {
      "command": "uvx",
      "args": ["--with", "mcp<2", "blender-mcp@1.5.6"],
      "description": "Blender MCP — ahujasid/blender-mcp, PyPI blender-mcp 1.5.6"
    },
    "unreal": {
      "command": "npx",
      "args": [
        "mcp-remote@0.1.38",
        "http://127.0.0.1:8088/mcp",
        "--transport",
        "http-only",
        "--allow-http"
      ],
      "description": "VibeUE UE MCP HTTP bridge — kevinpbuckley/VibeUE v0.1.0 in-editor plugin; mcp-remote 0.1.38 bridges Claude Code to the editor's HTTP endpoint on port 8088"
    }
  }
}
